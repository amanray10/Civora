// Prisma schema — AI-Powered Grievance System
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  citizen
  department
  admin
  superadmin
}

enum Priority {
  Low
  Medium
  High
  Critical
}

enum Status {
  Submitted
  AI_Processing
  Assigned
  Accepted
  In_Progress
  Resolved
  Rejected
  Closed
}

model User {
  id           Int           @id @default(autoincrement())
  googleId     String?       @unique
  name         String
  email        String        @unique
  password     String?       // bcrypt hash (email+password fallback)
  picture      String?
  role         Role          @default(citizen)
  isActive     Boolean       @default(true)
  deletedAt    DateTime?
  department   Department?   @relation(fields: [departmentId], references: [id])
  departmentId Int?
  complaints   Complaint[]
  chats        ChatHistory[]
  statusEdits  StatusHistory[]
  createdAt    DateTime      @default(now())
}

model Department {
  id             Int         @id @default(autoincrement())
  departmentName String      @unique
  email          String
  users          User[]
  complaints     Complaint[]
  createdAt      DateTime    @default(now())
}

model Complaint {
  id            Int             @id @default(autoincrement())
  user          User            @relation(fields: [userId], references: [id])
  userId        Int
  title         String
  description   String          @db.Text
  category      String?
  department    Department?     @relation(fields: [departmentId], references: [id])
  departmentId  Int?
  priority      Priority?
  status        Status          @default(Submitted)
  summary       String?         @db.Text
  location      String?
  latitude      Float?
  longitude     Float?
  nearbyFacilities Json?
  duplicateOf   Complaint?      @relation("Duplicates", fields: [duplicateId], references: [id])
  duplicateId   Int?
  duplicates    Complaint[]     @relation("Duplicates")
  attachments   Attachment[]
  statusHistory StatusHistory[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([departmentId])
}

model Attachment {
  id          Int       @id @default(autoincrement())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  complaintId Int
  filename    String
  path        String
  mimetype    String
  createdAt   DateTime  @default(now())
}

model StatusHistory {
  id          Int       @id @default(autoincrement())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  complaintId Int
  status      String
  note        String?
  updatedBy   User?     @relation(fields: [updatedById], references: [id])
  updatedById Int?
  timestamp   DateTime  @default(now())
}

model ChatHistory {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  question  String   @db.Text
  answer    String   @db.Text
  timestamp DateTime @default(now())
}
